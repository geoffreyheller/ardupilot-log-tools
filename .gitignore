# Parsed-log caches, written beside each .bin
*.dfcache

# Reference logs are not distributed - point LOG_DIR at them instead
reference-logs/
*.bin
*.tlog
*.rlog

# pymavlink vendored by tools/bootstrap_pymavlink.sh
vendor/

__pycache__/
*.pyc
.venv/

# local virtualenvs and build output
.venv*/
build/
dist/
*.egg-info/

# Scrubbed, trimmed test fixtures cut from real logs by tools/make_fixture.py
!tests/fixtures/*.bin

# Local map from neutral test-log labels to real log file names (see tests/test_toolkit.py)
*.local.json

# local agent worktrees and SDD scratch
.worktrees/
.superpowers/

# Docs copied into the package by setup.py at build time (never committed)
dflog/docs/
dflog/skill/
